{
  "name": "valhalla",
  "version": "0.0.1",
  "private": true,
  "description": "Valhalla — AI companions you define, through the Claude API",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write .",
    "check": "prettier --check . && oxlint && tsc -b && vitest run",
    "start": "node dist/server/index.js",
    "dev": "concurrently -k -n web,server -c blue,green \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=dev.env --watch server/index.ts",
    "smoke": "node --env-file-if-exists=dev.env scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.525.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.11"
  }
}
