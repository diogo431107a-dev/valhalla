{
  // The build tooling, the hand-run scripts, and the tests. Type-checked, never emitted.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.vite.tsbuildinfo"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts", "server/**/*.test.ts", "shared/**/*.test.ts"]
}
