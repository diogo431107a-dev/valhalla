# Copy this to dev.env and put your key in it. The server reads dev.env with
# --env-file-if-exists; it is in .gitignore and never committed.
#
# Copy it, don't move it: this file belongs in the repository so a fresh clone still has it.

# Your Claude API key. Leave it out if you signed in with `ant auth login` instead:
# the SDK finds that profile on its own.
ANTHROPIC_API_KEY=sk-ant-...

# Where the characters, personas and conversations are kept. Defaults to ./data
# VALHALLA_DATA=data

# Where the API listens. Defaults to 127.0.0.1:3100 — vite.config.ts proxies /api there.
# VALHALLA_HOST=127.0.0.1
# VALHALLA_PORT=3100
